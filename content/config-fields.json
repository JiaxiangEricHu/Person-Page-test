      "description": "顶板及盒身每侧增加的宽度；总宽自动限制在列间距内，避免相邻盒子相交。",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "categoryBoxRearExtension": {
      "default": 0.8,
      "title": "侧板向列后方延展",
      "description": "侧板覆盖该列显示行后，继续向后延伸的长度。",
      "type": "number",
      "minimum": 0,
      "maximum": 6
    },
    "categoryBoxLogoScale": {
      "default": 0.72,
      "title": "盒身 Logo 尺寸",
      "description": "前面与两侧的 Logo 显示比例；图片沿用该列的 logo 路径，没有图片时显示分类名称。",
      "type": "number",
      "minimum": 0.2,
      "maximum": 1
    }
  },
  "publishing": {
    "autoPublish": {
      "default": true,
      "title": "提交后自动发布",
      "description": "关闭后只构建检查，保留当前线上版本。手动发布请在 GitHub Actions 运行工作流并勾选 publish。",
      "type": "boolean"
    }
  }
}
