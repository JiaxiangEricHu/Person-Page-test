{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scene",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cardAspect": {
      "default": 1.4142857142857144,
      "title": "档案高宽比",
      "description": "档案高宽比",
      "type": "number",
      "minimum": 1.1,
      "maximum": 1.7
    },
    "exposedFraction": {
      "default": 0.3333333333333333,
      "title": "档案露出高度比例",
      "description": "档案露出高度比例",
      "type": "number",
      "minimum": 0.25,
      "maximum": 0.45
    },
    "backgroundWave": {
      "default": 0.78,
      "title": "背景波浪幅度",
      "description": "背景波浪幅度",
      "type": "number",
      "minimum": 0,
      "maximum": 1.2
    },
    "selectionWave": {
      "default": 0.82,
      "title": "点击波浪幅度",
      "description": "点击波浪幅度",
      "type": "number",
      "minimum": 0,
      "maximum": 1.2
    },
    "idleWave": {
      "default": 1,
      "title": "待机起伏倍率",
      "description": "待机起伏倍率",
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "rowDamping": {
      "default": 3.7,
      "title": "纵向切换收敛速度",
      "description": "纵向切换收敛速度",
      "type": "number",
      "minimum": 2,
      "maximum": 12
    },
    "laneDamping": {
      "default": 6.2,
      "title": "横向切换收敛速度",
      "description": "横向切换收敛速度",
      "type": "number",
      "minimum": 2,
      "maximum": 12
    },
    "hoverLift": {
      "default": 0.28,
      "title": "悬停抬升高度",
      "description": "悬停抬升高度",
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "wheelRowThreshold": {
      "default": 100,
      "title": "滚轮纵向切换阈值",
      "description": "滚轮纵向切换阈值",
      "type": "number",
      "minimum": 40,
      "maximum": 300
    },
    "wheelLaneThreshold": {
      "default": 150,
      "title": "滚轮横向切换阈值",
      "description": "滚轮横向切换阈值",
      "type": "number",
      "minimum": 40,
      "maximum": 300
    },
    "wheelCooldown": {
      "default": 160,
      "title": "滚轮切换间隔 ms",
      "description": "滚轮切换间隔 ms",
      "type": "number",
      "minimum": 80,
      "maximum": 500
    },
    "pixelRatio": {
      "default": 1.5,
      "title": "渲染像素比上限",
      "description": "渲染像素比上限",
      "type": "number",
      "minimum": 1,
      "maximum": 2
    },
    "depthOfField": {
      "default": 0,
      "title": "景深强度",
      "description": "景深强度",
      "type": "number",
      "minimum": 0,
      "maximum": 30
    },
    "exposure": {
      "default": 0.98,
      "title": "场景曝光",
      "description": "场景曝光",
      "type": "number",
      "minimum": 0.5,
      "maximum": 1.5
    },
    "reduceMotion": {
      "default": false,
      "title": "减少动态效果",
      "description": "始终尊重操作系统减少动画设置；此开关可额外减少。",
      "type": "boolean"
    },
    "floor": {
      "default": "#090c0f",
      "title": "三维地面颜色",
      "description": "三维地面颜色",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "fog": {
      "default": "#0b1014",
      "title": "雾颜色",
      "description": "雾颜色",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "polymer": {
      "default": "#626b70",
      "title": "档案外壳",
      "description": "档案外壳",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "edges": {
      "default": "#687277",
      "title": "档案边缘",
      "description": "档案边缘",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "diffuser": {
      "default": "#192226",
      "title": "档案内层",
      "description": "档案内层",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "fasteners": {
      "default": "#b1b9bb",
      "title": "档案紧固件",
      "description": "档案紧固件",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "inlay": {
      "default": "#c6a36b",
      "title": "档案索引",
      "description": "档案索引",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "printedLabel": {
      "default": "#303a3e",
      "title": "印刷底层",
      "description": "印刷底层",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "optics": {
      "default": "#939e9f",
      "title": "光学内层",
      "description": "光学内层",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "opticalEdges": {
      "default": "#bbc3bc",
      "title": "透明边缘",
      "description": "透明边缘",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "ink": {
      "default": "#b6bdb8",
      "title": "墨色",
      "description": "墨色",
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "lightweightGeometry": {
      "default": true,
      "title": "轻量模型",
      "description": "使用程序生成的低面数卡片，免加载 GLB。",
      "type": "boolean"
    },
    "showCategoryBoxes": {
      "default": true,
      "title": "显示分类盒",
      "description": "显示清晰顶面标签，以及向下、沿列延伸的分类盒身。",
      "type": "boolean"
    },
    "categoryBoxWidth": {
      "default": 4.3,
      "title": "分类盒宽度",
      "description": "三维场景中的盒子宽度。",
      "type": "number",
      "minimum": 2,
      "maximum": 4.8
    },
    "categoryBoxDepth": {
      "default": 2.3,
      "title": "分类盒深度",
      "description": "增加深度可容纳更大关键词面板。",
      "type": "number",
      "minimum": 1,
      "maximum": 4
    },
    "categoryBoxHeight": {
      "default": 0.48,
      "title": "分类盒顶板厚度",
      "description": "顶部标签底板的厚度；盒身自动向下延伸至地面。",
      "type": "number",
      "minimum": 0.2,
      "maximum": 1
    },
    "categoryBoxGap": {
      "default": 0.6,
      "title": "分类盒与阵列间距",
      "description": "盒子与最外侧一行的间距。",
      "type": "number",
      "minimum": 0.2,
      "maximum": 6
    },
    "categoryBoxElevation": {
      "default": 3.2,
      "title": "分类盒抬升高度",
      "description": "顶板距地面的固定高度；盒身延伸到地面，不随项目选择、滚动或波浪升降。",
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "categoryBoxSideExtension": {
      "default": 0.4,
      "title": "盒身左右延展",
      "description": "顶板及盒身每侧增加的宽度；总宽自动限制在列间距内，避免相邻盒子相交。",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "categoryBoxRearExtension": {
      "default": 64,
      "title": "盒身向后延展",
      "description": "两侧和底板向后延伸的长度；默认 64 延伸至画面外，避免快速滑动时档案越过可见后沿。只改变长度，不增加模型面数。",
      "type": "number",
      "minimum": 0,
      "maximum": 160
    },
    "categoryBoxLogoScale": {
      "default": 0.72,
      "title": "盒身 Logo 尺寸",
      "description": "前面与两侧的 Logo 显示比例；图片沿用该列的 logo 路径，没有图片时显示分类名称。",
      "type": "number",
      "minimum": 0.2,
      "maximum": 1
    },
    "fillCategoryBoxes": {
      "default": true,
      "title": "档案向后补满盒子",
      "description": "按各列现有项目循环补齐盒内可见空档；仅渲染视野附近的档案。关闭后按每列基础行数显示。",
      "type": "boolean"
    },
    "showEdgeRecesses": {
      "default": false,
      "title": "显示两侧地面孔槽",
      "description": "开启时显示阵列两侧的装饰孔槽；关闭时恢复完整地面。",
      "type": "boolean"
    },
    "detailArrayDrop": {
      "default": 20,
      "title": "详情展开时阵列退场距离",
      "description": "盒子与背景档案一起平滑下移的距离；返回时一起归位。0 表示只跟随镜头移动。",
      "type": "number",
      "minimum": 0,
      "maximum": 40
    }
  },
  "required": [
    "cardAspect",
    "exposedFraction",
    "backgroundWave",
    "selectionWave",
    "idleWave",
    "rowDamping",
    "laneDamping",
    "hoverLift",
    "wheelRowThreshold",
    "wheelLaneThreshold",
    "wheelCooldown",
    "pixelRatio",
    "depthOfField",
    "exposure",
    "reduceMotion",
    "floor",
    "fog",
    "polymer",
    "edges",
    "diffuser",
    "fasteners",
    "inlay",
    "printedLabel",
    "optics",
    "opticalEdges",
    "ink",
    "lightweightGeometry",
    "showCategoryBoxes",
    "categoryBoxWidth",
    "categoryBoxDepth",
    "categoryBoxHeight",
    "categoryBoxGap",
    "categoryBoxElevation",
    "categoryBoxSideExtension",
    "categoryBoxRearExtension",
    "categoryBoxLogoScale",
    "fillCategoryBoxes",
    "showEdgeRecesses",
    "detailArrayDrop"
  ],
  "additionalProperties": false
}
