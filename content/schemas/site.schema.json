{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "site",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "default": "Eric · Research Archive",
      "title": "网站标题",
      "description": "网站标题",
      "type": "string"
    },
    "name": {
      "default": "Eric Hu",
      "title": "姓名",
      "description": "姓名",
      "type": "string"
    },
    "brand": {
      "default": "ERIC",
      "title": "左上角品牌",
      "description": "左上角品牌",
      "type": "string"
    },
    "description": {
      "default": "关注微电子、可穿戴设备与生物传感，探索从器件到系统的研究与设计。",
      "title": "个人简介",
      "description": "个人简介",
      "type": "string"
    },
    "groups": {
      "default": [
        {
          "id": "group-01",
          "name": "半导体",
          "keywords": [
            "SEMICONDUCTORS",
            "器件 · 微电子"
          ],
          "logo": "",
          "color": "#c7a66e",
          "visibleRows": 8,
          "enabled": true
        },
        {
          "id": "group-02",
          "name": "PCB",
          "keywords": [
            "PCB DESIGN",
            "电路 · 系统"
          ],
          "logo": "",
          "color": "#87b6aa",
          "visibleRows": 8,
          "enabled": true
        },
        {
          "id": "group-03",
          "name": "研究与设计",
          "keywords": [
            "RESEARCH",
            "原型 · 探索"
          ],
          "logo": "",
          "color": "#a0a9c7",
          "visibleRows": 8,
          "enabled": true
        }
      ],
      "title": "分类列",
      "description": "增删或排序列；用固定 ID 关联项目，每列独立设置显示行数、关键词与 Logo。",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "固定 ID，与项目 group 匹配"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "logo": {
            "type": "string",
            "description": "uploads/图片.png，本地图片，可留空"
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          },
          "visibleRows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 48
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "keywords",
          "logo",
          "color",
          "visibleRows",
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    "topics": {
      "default": [
        "Microelectronics",
        "Wearables",
        "Biosensing"
      ],
      "title": "研究标签",
      "description": "每行一个；可以清空。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contactLabel": {
      "default": "",
      "title": "联系按钮文字",
      "description": "为空时不显示。",
      "type": "string"
    },
    "contactUrl": {
      "default": "",
      "title": "联系按钮地址",
      "description": "支持 https:// 或 mailto:；为空时不显示。",
      "type": "string",
      "pattern": "^$|^(https?://|mailto:)"
    }
  },
  "required": [
    "title",
    "name",
    "brand",
    "description",
    "groups",
    "topics",
    "contactLabel",
    "contactUrl"
  ],
  "additionalProperties": false
}
